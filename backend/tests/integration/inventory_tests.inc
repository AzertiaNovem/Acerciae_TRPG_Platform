    test("story inventory transactions are atomic, idempotent and protect full-card saves", [&] {
        Json::Value body; body["name"]="Inventory fixtures";
        auto ch=S.chat->createChannel(gmP,server["id"].asString(),body)["id"].asString();
        auto keeper=S.auth->channelAccess(gmUser,ch);
        auto make=[&](const char* name) { Json::Value b; b["name"]=name; b["kind"]="npc"; return S.chat->createCharacter(keeper,b)["id"].asString(); };
        auto first=make("Sender"), second=make("Recipient");
        auto now=std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::system_clock::now().time_since_epoch()).count();
        auto denied=[&](auto fn,int status) { bool caught=false; try { fn(); } catch(const ApiError& e) { caught=e.status()==status; } CHECK(caught); };
        auto items=json::parse(R"([{"name":"Brass key","note":"old","qty":2}])");
        Json::Value op;op["request_id"]="gain-one";op["issued_at"]=Json::Int64(now);op["reason"]="Found a key";
        Json::Value change;change["character_id"]=first;change["expected_version"]=0;change["items"]=items;op["changes"].append(change);
        auto before=S.db->queryOne("SELECT role_card FROM characters WHERE id=$1",{first})["role_card"];
        const auto result=inventory::apply(*S.db,keeper,op);
        CHECK(result["characters"][0]["version"].asInt()==1);
        CHECK(inventory::apply(*S.db,keeper,op)==result);
        auto altered=op;altered["changes"][0]["items"][0]["qty"]=3;
        denied([&]{inventory::apply(*S.db,keeper,altered);},409);
        auto player=keeper;player.isGm=false;
        denied([&]{inventory::read(*S.db,player);},403);
        denied([&]{inventory::apply(*S.db,player,op);},403);
        auto current=S.db->queryOne("SELECT * FROM characters WHERE id=$1",{first});
        auto remaining=current["role_card"];remaining.removeMember("items");before.removeMember("items");CHECK(remaining==before);
        Json::Value save;save["role_card"]=current["role_card"];save["role_card"]["items"]=Json::Value(Json::arrayValue);
        denied([&]{S.characterSpace->updateCard(keeper,first,save);},409);
        save["expected_inventory_version"]=0;
        denied([&]{S.characterSpace->updateCard(keeper,first,save);},409);
        save["expected_inventory_version"]=1;
        S.characterSpace->updateCard(keeper,first,save);
        CHECK(S.db->queryOne("SELECT inventory_version FROM characters WHERE id=$1",{first})["inventory_version"].asInt()==2);
        op["request_id"]="gain-two";op["changes"][0]["expected_version"]=2;inventory::apply(*S.db,keeper,op);
        auto transfer=op;transfer["request_id"]="transfer";transfer["changes"][0]["expected_version"]=3;transfer["changes"][0]["items"][0]["qty"]=1;
        change["character_id"]=second;change["expected_version"]=99;change["items"][0]["qty"]=1;transfer["changes"].append(change);
        denied([&]{inventory::apply(*S.db,keeper,transfer);},409);
        CHECK(S.db->queryOne("SELECT role_card FROM characters WHERE id=$1",{first})["role_card"]["items"][0]["qty"].asInt()==2);
        transfer["changes"][1]["expected_version"]=0;
        auto moved=inventory::apply(*S.db,keeper,transfer);CHECK(moved["characters"].size()==2);
        CHECK(inventory::apply(*S.db,keeper,transfer)==moved);
        for(const auto& c:moved["characters"]) CHECK(c["items"][0]["qty"].asInt()==1);
        auto expired=transfer;expired["request_id"]="expired";expired["issued_at"]=Json::Int64(now-8LL*86400000);
        denied([&]{inventory::apply(*S.db,keeper,expired);},409);

        const auto window=S.chat->listWindows(keeper)[0]["id"].asString();
        Json::Value line;line["kind"]="narration";line["content"]="The key changes hands.";line["request_id"]="turn-1";line["request_issued_at"]=Json::Int64(now);
        const auto msg=S.chat->postMessage(keeper,window,line);
        CHECK(S.chat->postMessage(keeper,window,line)["id"]==msg["id"]);
        CHECK(S.db->queryOne("SELECT count(*) AS n FROM messages WHERE chat_window_id=$1 AND content=$2",{window,line["content"].asString()})["n"].asInt()==1);
        line["content"]="Different";denied([&]{S.chat->postMessage(keeper,window,line);},409);
        line["content"]="The key changes hands.";
        S.db->exec("UPDATE messages SET recalled_at=now() WHERE id=$1",{msg["id"].asString()});
        CHECK(!S.chat->postMessage(keeper,window,line)["recalled_at"].isNull());
        line["request_id"]="cancelled";
        S.db->exec("INSERT INTO agent_message_receipts(channel_id,actor_id,request_id,cancelled) VALUES($1,$2,'cancelled',true)",{ch,gmUser});
        denied([&]{S.chat->postMessage(keeper,window,line);},409);
        line["request_id"]="expired";line["request_issued_at"]=Json::Int64(now-8LL*86400000);
        denied([&]{S.chat->postMessage(keeper,window,line);},409);
    });
