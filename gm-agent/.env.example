# Acerciae backend and the Keeper account the client signs in as (it must be the GM of the channel).
ACERCIAE_API_BASE=http://localhost:8080
GM_USERNAME=aikeeper
GM_PASSWORD=change-me
GM_DISPLAY_NAME=AI Keeper
# GM_REGISTER=true            # register the account on first run

# The channel to keep (setup prints it); how many co-players the LLM creates; where they sit.
CHANNEL_ID=
COPLAYERS=2
# COPLAYER_WINDOWS=Main Chat
# CAMPAIGN_ERA=1920s
# GM_LANGUAGE=en              # default: the server's language

# The client's own model. Claude: set ANTHROPIC_API_KEY (LLM_PROVIDER defaults to anthropic when it is set).
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=medium
# Any OpenAI-compatible endpoint instead:
# LLM_PROVIDER=openai_compatible
# LLM_API_BASE=https://api.example.com/v1
# LLM_MODEL=
# LLM_API_KEY=
# LLM_STREAM=true            # OpenAI-compatible: stream long replies to avoid idle gateway timeouts
# LLM_TIMEOUT_MS=600000      # client deadline; cannot override a gateway's own timeout
# LLM_PROVIDER=mock           # labelled placeholder text, for tests and demos

# Pacing
# DEBOUNCE_MS=4000
# POST_DELAY_MS=1200
# MAX_ACTIONS_PER_TURN=6
# CONTEXT_LINES=60
# LLM_TRACE=./llm-trace.jsonl # audit what each role was shown
