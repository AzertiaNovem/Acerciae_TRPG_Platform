# ---------------------------------------------------------------------------
# Acerciae TRPG Platform — environment configuration
# Copy to .env and adjust. Docker Compose reads this file automatically.
# ---------------------------------------------------------------------------

# PostgreSQL
POSTGRES_USER=acerciae
# Change this, and use the same password in DATABASE_URL.
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=acerciae
# Connection string used by the backend (inside docker-compose the host is "db")
DATABASE_URL=postgresql://acerciae:change-this-database-password@db:5432/acerciae

# Backend HTTP/WebSocket server
HTTP_PORT=8080
# Socket event loops; ordinary API work and LLM work use separate bounded pools.
HTTP_THREADS=4
API_WORKERS=8
API_QUEUE_LIMIT=256
# Secret used to derive auth-token hashes and to encrypt per-server API keys. Required: at least 32 characters,
# e.g. `openssl rand -hex 32`; the backend refuses to start with a missing, short or published value. Changing it
# later signs everyone out and makes stored server API keys unreadable (maintainers must re-enter them).
AUTH_SECRET=
# Local development only: accept a weak AUTH_SECRET and allow SEED_DEMO. Never set this in production.
ALLOW_INSECURE_DEV=false
# Origins allowed to call the API from another origin (comma-separated). Empty = same origin only, which is all the
# bundled frontend needs. Example for a separate dev server: http://localhost:5173
CORS_ORIGINS=
# Behind a reverse proxy: take the client address from X-Real-IP / X-Forwarded-For (for login throttling).
# docker-compose sets this for the bundled frontend proxy. Only enable it when the backend is not reachable directly.
TRUST_PROXY=false
# New accounts per client address per hour
AUTH_REGISTER_PER_HOUR=20
# Retention of finished background AI job rows and studio audit rows (days). Expired sessions are always swept.
RETENTION_AI_JOB_DAYS=30
RETENTION_AUDIT_DAYS=365
# Token lifetime in hours
AUTH_TOKEN_TTL_HOURS=168
# Directory for uploaded module PDFs (inside the container)
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=50

# AI providers are configured per server by its maintainers (Server settings -> AI): language model, embeddings,
# images and speech, each with the server's own encrypted key, plus the server's token/image budgets and how many
# AI tasks it may run at once. There are no platform-wide AI keys; a server without a provider runs in MOCK mode.
# These only tune the calls the servers make:
LLM_TIMEOUT_MS=60000
LLM_MAX_TOKENS=8192
# Module graph extraction and Keeper knowledge preparation use a larger independent limit.
LLM_MODULE_MAX_TOKENS=32768
LLM_MODULE_TIMEOUT_MS=300000
LLM_TEMPERATURE=0.2
# Threads that run model calls triggered by requests (keeps HTTP threads free).
AI_HTTP_WORKERS=4
# Dedicated nonblocking model HTTP reactor (shared by interactive and background model calls).
LLM_MAX_CONNECTIONS=32
LLM_QUEUE_LIMIT=128
# Provider endpoints must be https on a public address. Set true only for a trusted self-hosted model on a private
# network (it also allows http); any server maintainer can then point AI calls at internal addresses.
AI_ALLOW_PRIVATE_ENDPOINTS=false

# AI observer schedulers
AI_OBSERVER_ENABLED=true
AI_OBSERVER_INTERVAL_MS=5000
AI_CONSOLIDATOR_INTERVAL_MS=60000
AI_OBSERVER_MAX_BATCH=40
# Highlight lifetime and cleanup cadence
HIGHLIGHT_TTL_SECONDS=900
HIGHLIGHT_CLEANUP_INTERVAL_MS=30000

# Seed the demonstration campaign on first start (true/false). Its accounts share the password "password", so it
# only runs together with ALLOW_INSECURE_DEV=true.
SEED_DEMO=false

# Frontend dev server only (npm run dev): API base baked into the bundle; empty = same origin through the dev proxy.
# The compose frontend is built without it and always talks to its own origin. ACERCIAE_API_TARGET points the dev
# proxy at another backend (default http://localhost:8080).
VITE_API_BASE=
# ACERCIAE_API_TARGET=http://localhost:8080

# Where the backend finds its SQL migrations (the images set this).
# MIGRATIONS_DIR=./migrations
# Development/testing: fail any request that opens a nested database transaction (a pool-deadlock risk).
# ACERCIAE_STRICT_DB=1

# Log Studio: media, speech, images, publication
# Where media is stored: local (UPLOAD_DIR/objects), s3 (MinIO, AWS S3, …) or r2 (Cloudflare R2).
OBJECT_STORE=local
# Images only (uploaded and generated portraits, backgrounds, visual-novel art) can go elsewhere; defaults
# to OBJECT_STORE. Set IMAGE_STORE=r2 to keep images in Cloudflare R2, IMAGE_STORE=local to switch back. Images
# written under the other setting stay readable while its settings remain configured below (the local directory is
# always read); copy them across with `acerciae-server --copy-images r2 local` (or `--copy-media` for all media).
IMAGE_STORE=local
# Cloudflare R2 (used when OBJECT_STORE or IMAGE_STORE is r2). Create a private bucket and an R2 API token with
# Object Read & Write on that bucket only; the token's S3 credentials go here.
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_BUCKET=acerciae-images
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Optional: a different endpoint, e.g. the EU jurisdiction https://<account id>.eu.r2.cloudflarestorage.com
# R2_ENDPOINT=
# R2 is reached through HTTP(S)_PROXY when one is set; set false to connect directly.
# R2_USE_PROXY=true
# Direct downloads: a second, publicly readable bucket (custom domain or r2.dev) for media that is not secret —
# AI-generated art, voice clips and user avatars. The backend still checks permissions, then redirects browsers to
# R2_PUBLIC_BASE_URL/<key>, so those bytes no longer pass through this server. Remove R2_PUBLIC_BASE_URL to stream
# everything through the backend again (keep R2_PUBLIC_BUCKET while existing objects are still only there).
# R2_PUBLIC_BUCKET=acerciae-public
# R2_PUBLIC_BASE_URL=https://media.example.com
# At every start, media still on the local disk is sent to the object storage configured above (and non-secret media to
# the public bucket); set false to skip. Local copies are kept unless MEDIA_MIGRATION_DELETE_LOCAL=true.
# MEDIA_MIGRATION=true
# MEDIA_MIGRATION_DELETE_LOCAL=false
# S3_ENDPOINT=http://minio:9000
# S3_BUCKET=acerciae
# S3_REGION=us-east-1
# S3_ACCESS_KEY=acerciae
# S3_SECRET_KEY=replace-with-a-strong-secret
# Path-style addressing (MinIO and most self-hosted stores): true
# S3_PATH_STYLE=true
# Create the private S3 bucket before use; enable the optional compose s3 profile.
# Qwen speech details shared by every server that picks Qwen (the key, base URL and model are per server).
QWEN_TTS_MODEL_PREVIEW=qwen-audio-3.1-tts-flash
QWEN_TTS_ENDPOINT=/api/v1/services/audio/tts/SpeechSynthesizer
QWEN_VOICE_ENROLL_MODEL=voice-enrollment
QWEN_VOICE_DESIGN_MODEL=voice-enrollment
# Overrides for regional or proxied deployments (defaults follow Alibaba's documentation)
# QWEN_VOICE_ENROLL_ENDPOINT=/api/v1/services/audio/tts/customization
# QWEN_TTS_INSTRUCTION_FIELD=instruction
QWEN_TTS_VOICES=longanhuan_v3.1:Anhuan:zh:female,xunanchuan_v3.1:Nanchuan:zh:male
QWEN_TIMEOUT_MS=60000
TTS_CONCURRENCY=2
# Optional estimate in your chosen currency per 10k characters; flash uses token billing.
TTS_PRICE_PER_10K_CHARS=0
# Generate once (e.g. openssl rand -hex 32), then share only between backend and PDF worker.
PDF_WORKER_TOKEN=
# PDF worker: the Chromium/Chrome binary it drives (its image sets /usr/bin/chromium)
# CHROMIUM_PATH=/usr/bin/chromium
