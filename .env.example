# ---------------------------------------------------------------------------
# Acerciae TRPG Platform — environment configuration
# Copy to .env and adjust. Docker Compose reads this file automatically.
# ---------------------------------------------------------------------------

# PostgreSQL
POSTGRES_USER=acerciae
POSTGRES_PASSWORD=acerciae
POSTGRES_DB=acerciae
# Connection string used by the backend (inside docker-compose the host is "db")
DATABASE_URL=postgresql://acerciae:acerciae@db:5432/acerciae

# Backend HTTP/WebSocket server
HTTP_PORT=8080
HTTP_THREADS=4
# Secret used to derive auth-token hashes and to encrypt per-server API keys. Change in production;
# changing it later makes stored server LLM/TTS keys unreadable (maintainers must re-enter them).
AUTH_SECRET=change-me-in-production
# Token lifetime in hours
AUTH_TOKEN_TTL_HOURS=168
# Directory for uploaded module PDFs (inside the container)
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=50

# LLM gateway (OpenAI-compatible chat completions API).
# Leave LLM_API_KEY empty to run in clearly-labelled MOCK LLM MODE.
LLM_PROVIDER=openai_compatible
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=60000
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2
# Optional embedding model for pgvector semantic retrieval (empty = disabled)
LLM_EMBEDDING_MODEL=

# AI observer schedulers
AI_OBSERVER_ENABLED=true
AI_OBSERVER_INTERVAL_MS=5000
AI_CONSOLIDATOR_INTERVAL_MS=60000
AI_OBSERVER_MAX_BATCH=40
# Highlight lifetime and cleanup cadence
HIGHLIGHT_TTL_SECONDS=900
HIGHLIGHT_CLEANUP_INTERVAL_MS=30000

# Seed the demonstration campaign on first start (true/false)
SEED_DEMO=true

# Frontend (Vite dev server) — API base; empty means same origin via proxy
VITE_API_BASE=
