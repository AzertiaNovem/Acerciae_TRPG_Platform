# ---------------------------------------------------------------------------
# Acerciae TRPG Platform — environment configuration
# Copy to .env and adjust. Docker Compose reads this file automatically.
# ---------------------------------------------------------------------------

# PostgreSQL
POSTGRES_USER=acerciae
POSTGRES_PASSWORD=acerciae
POSTGRES_DB=acerciae
# Connection string used by the backend (inside docker-compose the host is "db")
DATABASE_URL=postgresql://acerciae:acerciae@db:5432/acerciae

# Backend HTTP/WebSocket server
HTTP_PORT=8080
HTTP_THREADS=4
# Secret used to derive auth-token hashes and to encrypt per-server API keys. Change in production;
# changing it later makes stored server LLM/TTS keys unreadable (maintainers must re-enter them).
AUTH_SECRET=change-me-in-production
# Token lifetime in hours
AUTH_TOKEN_TTL_HOURS=168
# Directory for uploaded module PDFs (inside the container)
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=50

# LLM gateway (OpenAI-compatible chat completions API).
# Leave LLM_API_KEY empty to run in clearly-labelled MOCK LLM MODE.
LLM_PROVIDER=openai_compatible
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=60000
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2
# Optional embedding model for pgvector semantic retrieval (empty = disabled)
LLM_EMBEDDING_MODEL=

# AI observer schedulers
AI_OBSERVER_ENABLED=true
AI_OBSERVER_INTERVAL_MS=5000
AI_CONSOLIDATOR_INTERVAL_MS=60000
AI_OBSERVER_MAX_BATCH=40
# Highlight lifetime and cleanup cadence
HIGHLIGHT_TTL_SECONDS=900
HIGHLIGHT_CLEANUP_INTERVAL_MS=30000

# Seed the demonstration campaign on first start (true/false)
SEED_DEMO=true

# Frontend (Vite dev server) — API base; empty means same origin via proxy
VITE_API_BASE=

# Log Studio: media, speech, images, publication
OBJECT_STORE=local
# S3_ENDPOINT=http://minio:9000
# S3_BUCKET=acerciae
# S3_REGION=us-east-1
# S3_ACCESS_KEY=acerciae
# S3_SECRET_KEY=replace-with-a-strong-secret
# Create the private S3 bucket before use; enable the optional compose s3 profile.
TTS_PROVIDER=auto
QWEN_API_KEY=
# Prefer your workspace's regional host; use the API key for the same region.
# QWEN_API_BASE=https://YOUR_WORKSPACE.ap-southeast-1.maas.aliyuncs.com
QWEN_TTS_MODEL_OFFICIAL=qwen-audio-3.1-tts-plus
QWEN_TTS_MODEL_PREVIEW=qwen-audio-3.1-tts-flash
QWEN_TTS_ENDPOINT=/api/v1/services/audio/tts/SpeechSynthesizer
QWEN_VOICE_ENROLL_MODEL=voice-enrollment
QWEN_VOICE_DESIGN_MODEL=voice-enrollment
QWEN_TTS_VOICES=longanhuan_v3.1:Anhuan:zh:female,xunanchuan_v3.1:Nanchuan:zh:male
QWEN_TIMEOUT_MS=60000
TTS_CONCURRENCY=2
# Optional estimate in your chosen currency per 10k characters; flash uses token billing.
TTS_PRICE_PER_10K_CHARS=0
IMAGE_PROVIDER=disabled
# IMAGE_PROVIDER=mock produces labelled procedural test patterns, not AI art.
# IMAGE_PROVIDER=http uses the documented gateway contract in docs/ASSETS.md.
IMAGE_API_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
# Generate once (e.g. openssl rand -hex 32), then share only between backend and PDF worker.
PDF_WORKER_TOKEN=
