{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Acerciae",
  "version": "0.1.0",
  "identifier": "app.acerciae.desktop",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "beforeBuildCommand": "npm --prefix ../frontend run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Acerciae",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/projects/**",
          "$APPCACHE/print/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "RolePlayingGame",
    "shortDescription": "Acerciae TRPG table",
    "copyright": "Copyright \u00a9 AzertiaFlores",
    "license": "BSD-3-Clause",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
