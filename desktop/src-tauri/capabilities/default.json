{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the app's own pages may call: dialogs, notifications, opening links in the browser, events.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-request-user-attention",
    "dialog:default",
    "notification:default",
    "opener:default",
    "opener:allow-reveal-item-in-dir"
  ]
}
